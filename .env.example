JWT_SECRET=your_shared_jwt_secret_key_here
JWT_ALGORITHM=HS256
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=chatbot_db
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Qdrant Cloud Cluster Configuration (Obtained from cloud.qdrant.io dashboard)
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Embedding & Vector RAG Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
AVAILABLE_COLLECTIONS=gita_collection,mahabharata_collection

# Logging (optional, default INFO). Use DEBUG for verbose request/retrieval tracing.
LOG_LEVEL=INFO
